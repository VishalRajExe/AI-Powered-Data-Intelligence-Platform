{
  "name": "@aidp/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:db": "vitest run tests/database.integration.test.ts"
  },
  "dependencies": {
    "@aidp/firecrawl-agent-core": "0.1.0-vendor.1",
    "ai": "6.0.293",
    "@ai-sdk/anthropic": "^3.0.69",
    "@ai-sdk/google": "^3.0.62",
    "@ai-sdk/openai": "^3.0.52",
    "@langchain/anthropic": "^1.3.26",
    "@langchain/google": "^0.1.10",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/openai": "^1.4.4",
    "@prisma/client": "6.12.0",
    "bullmq": "6.3.9",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "prisma": "6.12.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
