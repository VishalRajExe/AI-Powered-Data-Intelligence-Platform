<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>ai.finalagent</groupId>
  <artifactId>backend</artifactId>
  <version>0.1.0</version>
  <name>finalagent-backend</name>
  <description>Spring Boot orchestrator and system of record for FINALAIAGENT</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Authentication, not authorisation-by-convention. Only two pieces of it are used: the filter
         chain in SecurityConfig (session cookie, CSRF, the role ladder) and BCryptPasswordEncoder.
         No form login, no http basic, no OAuth client — each of those would add an endpoint this API
         does not have. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- JDBC, not JPA: the schema is written as SQL and versioned by Flyway, and the queue needs
         statements (SKIP LOCKED, conditional UPDATE) that an ORM would only get in the way of. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <!-- Flyway 10 split MySQL support out of flyway-core; without it `flyway migrate` on a
          mysql:// URL fails before the first statement runs. -->
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- XLSX only. Writing the OOXML package by hand is a bug farm, and POI's streaming writer (SXSSF)
         is the one that keeps memory flat when the dataset is large. CSV and JSON need nothing. -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.4.1</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- `authentication(...)` and `csrf()`. The non-database controller suites need a principal on
         the request without a MySQL session to stand behind it; hand-rolling that would mean either a
         fake SessionRepository in the test context (a second implementation of the thing under test)
         or a real database in suites that are about something else. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
