# FINALAIAGENT frontend — server-side configuration only.
# No secrets belong here: the browser must never receive a backend credential,
# and the Python AI service is reachable only through the backend, never directly.

# Origin the Next.js server proxies /api/v1/* to (server-side only, never NEXT_PUBLIC_*).
# Local native Spring Boot default is 8080; compose may override it.
BACKEND_ORIGIN=http://localhost:8080

# IMPORTANT: `next build` resolves the rewrite into .next/routes-manifest.json, so in
# production/compose BACKEND_ORIGIN must be present at BUILD time as well as at `next start`.
# `next dev` reads next.config.js on boot and needs it only there.
