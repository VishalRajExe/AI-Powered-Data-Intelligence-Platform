# Application
APP_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb
SOURCE_ROBOTS_USER_AGENT=ScoutlyBot
SOURCE_ROBOTS_TIMEOUT_MS=5000

# MySQL: use DATABASE_URL or the MYSQL_* components below.
# This connection targets the local services in docker-compose.yml.
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=aidp
MYSQL_PASSWORD=development-password
MYSQL_DATABASE=aidp_dev
MYSQL_ROOT_PASSWORD=development-root-password

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Firecrawl and configurable LLM. Leave keys blank until configured.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=
LLM_PROVIDER=google
LLM_MODEL_ID=gemini-3-flash-preview
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_BASE_URL=

# Authentication is not enabled in Phase 1. Set both secrets together when it is.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
