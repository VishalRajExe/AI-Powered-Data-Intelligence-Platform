# ============================================================================
# FINALAIAGENT - configuration contract
#
# This file lists variable NAMES and safe non-secret defaults. It is the single
# source of truth for what must exist in every environment.
#
#   cp .env.example .env      (run scripts/bootstrap-env.sh instead, it also
#                              generates the shared secrets for you)
#
# Rules enforced by this project:
#   - .env is gitignored. Never commit a filled-in copy.
#   - No secret may ever be prefixed NEXT_PUBLIC_ - the browser bundle is public.
#   - There is NO Redis, and no DEMO_MODE. A missing credential stops the process;
#     it never routes execution to a simulated adapter. That is deliberate.
# ============================================================================

# ---- shared -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
# Exact origin only: scheme + host + optional port, no path, no wildcard.
# The backend refuses to start on anything else, because credentialed CORS
# cannot use a wildcard and a wrong origin fails silently at request time.
FRONTEND_ORIGIN=http://localhost:3000

# ---- MySQL (the only state store; there is no Redis) --------------------
MYSQL_HOST=127.0.0.1
# Native MySQL usually owns 3306. `database/docker-compose.yml` publishes its
# container on 3307 so both can coexist; set MYSQL_PORT=3307 in that case.
MYSQL_PORT=3306
MYSQL_DATABASE=finalagent_dev
MYSQL_USER=
MYSQL_PASSWORD=
# Root password for the disposable container in database/ only. The applications never
# connect as root, and a native MySQL installation will not read this variable at all.
MYSQL_ROOT_PASSWORD=
# Host port the container is published on (3307, so a native MySQL on 3306 can coexist).
MYSQL_PUBLISH_PORT=3307

# ---- Spring Boot backend ------------------------------------------------
SERVER_PORT=8080
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=3000
# Shared secret for the Spring -> Python boundary. Min 32 chars.
# Generate: openssl rand -hex 32
AI_SERVICE_API_KEY=

# ---- workflow execution (Spring Boot owns the queue; there is no Redis) --
# Off by default. Enabling it also enables Flyway, because the migrations are the
# schema the queue's guarantees live in.
WORKFLOW_EXECUTION_ENABLED=false
# The tenancy root, read from here and never from a request. Until the authentication
# phase issues tokens that carry a workspace claim, this service is single-workspace by
# configuration, and any value here other than a UUID you control is a mistake.
FINALAGENT_WORKSPACE_ID=
# A polling interval below 100ms is a table scan every few milliseconds.
WORKFLOW_POLL_INTERVAL_MS=500
WORKFLOW_BATCH_SIZE=4
WORKFLOW_CORE_POOL_SIZE=4
WORKFLOW_MAX_POOL_SIZE=8
WORKFLOW_QUEUE_CAPACITY=100
# The lease must outlast a whole step with room to spare: a lease that expires mid-step
# is a second worker starting the same collection while the first is still spending
# credits on it. The startup validator refuses step-timeout >= lease-seconds.
WORKFLOW_LEASE_SECONDS=300
WORKFLOW_HEARTBEAT_SECONDS=30
WORKFLOW_MAX_ATTEMPTS=3
WORKFLOW_BACKOFF_BASE_SECONDS=1
WORKFLOW_BACKOFF_MAX_SECONDS=120
WORKFLOW_STEP_TIMEOUT_MS=240000

# ---- FastAPI AI service -------------------------------------------------
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
# Must equal the backend's AI_SERVICE_API_KEY.
GEMINI_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# Pin an exact model; never track a moving alias.
LLM_MODEL_ID=gemini-2.5-flash
LLM_REQUEST_TIMEOUT_SECONDS=45
EXTRACT_TIMEOUT_SECONDS=180
SEARCH_TIMEOUT_SECONDS=30
SCRAPE_TIMEOUT_SECONDS=60
# Hard deadline for ONE browser session. A session that exceeds it returns a structured
# timeout to the model instead of hanging the research loop.
INTERACT_TIMEOUT_SECONDS=60
MAX_SCHEMA_REPAIRS=3
MAX_COLLECT_CONCURRENCY=5
# Browser sessions are capped separately and lower: one is a live session with a TTL, not
# a request. Upstream bars them from parallel workers entirely.
MAX_INTERACT_CONCURRENCY=2
# The web tools this service may ever use, as a ceiling. A request can ask for a subset of
# this, never more. `interact` drives a page in a browser instead of only reading it, so it
# stays off until an operator turns it on here.
ALLOWED_WEB_TOOLS=search,scrape
# Per-run cap on browser sessions, for runs that are allowed to use them. 0 disables them
# even when ALLOWED_WEB_TOOLS includes `interact`.
MAX_INTERACTIONS_PER_RUN=3
MAX_LOOPS=6
MAX_SEARCH_RESULTS=5
MAX_SEARCHES_PER_RUN=8
MAX_SCRAPES_PER_RUN=12
# Directory of SKILL.md site playbooks this deployment owns. Relative paths resolve against
# the ai-service directory. An empty or missing directory is valid: the run simply has no
# playbooks. See ai-service/skills/README.md.
SKILLS_DIR=skills/definitions
# The AI service is internal; it rejects any other Host header.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- source curation (ai-service) -----------------------------------------
# Retry for web READS only. A browser session is never retried: each attempt would create
# another billable session, and it already has its own deadline and per-run budget.
# MaxAttempts is bounded 1-5 by the same RetryPolicy contract the workflow plan carries.
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1
RETRY_MAX_DELAY_SECONDS=20
# robots.txt is read before any scrape or browser session, once per origin per run.
ROBOTS_ENABLED=true
ROBOTS_TIMEOUT_SECONDS=5
# The token we ask robots.txt about. One word: rules match on substrings, so a phrase would
# match unpredictably.
ROBOTS_USER_AGENT=finalagent-research
# What to do when robots.txt cannot be read (5xx, DNS, timeout).
#   restrict = refuse the source and report why (default; never fetch blind)
#   allow    = fetch anyway and mark the run as having proceeded without a readable policy
# Note 401/403/404 mean "no rules", per RFC 9309 — they are not errors.
ROBOTS_ON_ERROR=restrict
# Ranking and diversity. Relevance is lexical: it counts the requested vocabulary in a result's
# title, snippet and URL path, saturating at four matched terms. It is not semantic similarity.
# 0.0 ranks without dropping anything — the scrape budget decides how many pages are read.
MIN_RELEVANCE_SCORE=0.0
# How many candidates from one publisher may enter a batch. 0 disables the rule.
MAX_SOURCES_PER_DOMAIN=2
# How many ranked candidates a single search offers the model.
MAX_CANDIDATES_PER_SEARCH=8

# --- data intelligence pipeline (Phase 8) ---
# Name similarity alone never merges two records: a shared stable identifier is required, and a pair
# that clears this threshold without one is marked REVIEW_REQUIRED instead. 0.94 is the conservative
# number the old service used — a false merge is invisible afterwards, a false split is not.
# Valid range 0.5-1.0; anything else stops the service at boot.
ENTITY_MATCH_THRESHOLD=0.94
# A blocking key shared by more records than this is reported and left uncompared rather than turned
# into a quadratic scan the caller waits for. Valid range 2-100000.
QUALITY_MAX_BLOCK_SIZE=400

# ---- Next.js frontend (server-side only) --------------------------------
# The Next server proxies /api/v1/* to this origin. The browser never sees it.
# NOTE: `next build` bakes this value into .next/routes-manifest.json, so it
# must be set at BUILD time as well as at `next start` in compose.
BACKEND_ORIGIN=http://localhost:8080

# ---- deferred to the authentication phase -------------------------------
# Not read by anything yet, so they are not required yet. When Spring Security
# lands (Phase 3) these become mandatory, min 32 chars, and must differ:
#   JWT_ACCESS_SECRET=
#   JWT_REFRESH_SECRET=
